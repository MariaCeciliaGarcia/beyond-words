  "units": [
    {
      "id": "e-lead-to",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明一种情况会带来什么结果",
      "expression": "…lead to…",
      "formula": "原因 + lead / leads to + 结果名词 / 动词-ing",
      "boundary": "to 是介词，后接名词或 -ing。lead to 表示因果，不能仅凭两件事同时出现就断定存在因果。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-result-from",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "从结果回头指出其原因",
      "expression": "…result from…",
      "formula": "结果 + result / results from + 原因",
      "boundary": "result from 后面是原因；result in 后面是结果。名词主语单数时用 results。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-due-to",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "用名词短语简洁说明原因",
      "expression": "…due to…",
      "formula": "结果 / 情况 + be due to + 原因名词短语",
      "boundary": "due to 后接名词或 -ing，不直接接独立完整句子。The delay is due to rain 与 because it is raining 的结构不同。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-for-instance",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "用具体情况支持刚才的概括",
      "expression": "For instance,…",
      "formula": "For instance, + 支持前述观点的具体例子",
      "boundary": "例子应支持前面的观点，不能把另一个未解释的概括当例子。for instance 与 for example 功能相近。",
      "functionGroup": "responses",
      "functionSubgroup": "examples-rephrasing",
      "functionName": "举例与换说法",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-in-particular",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "从一个范围中突出具体对象",
      "expression": "…in particular…",
      "formula": "in particular + 被强调的对象；或 对象 + in particular",
      "boundary": "位置应让读者清楚它强调谁。不要把 in particular 当作因果连接词或最高级。",
      "functionGroup": "responses",
      "functionSubgroup": "examples-rephrasing",
      "functionName": "举例与换说法",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-rather-than",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "把两个选择对照，说明选择前者",
      "expression": "…rather than…",
      "formula": "选择的做法 + rather than + 对照的做法",
      "boundary": "不要与 would rather… 的完整结构混淆。比较两个名词或动作时，保持语法形式平行。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-instead-of",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明用一个做法替代另一个",
      "expression": "instead of…",
      "formula": "instead of + 名词 / 动词-ing",
      "boundary": "of 后接动作时用 -ing：instead of driving。不要写 instead of to drive。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-both-and",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "同时表达两方面都成立",
      "expression": "both…and…",
      "formula": "both + A + and + B",
      "boundary": "both A and B 作主语通常用复数谓语。不要一边放名词，一边放完整句子。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-not-only",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "在已有一项之外补充另一个重要方面",
      "expression": "not only…but also…",
      "formula": "not only + A + but also + B",
      "boundary": "两项形式保持平行。放在句首可能涉及倒装；放在句中可以避免不必要的复杂结构。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-in-contrast",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "突出与前面情况的明显不同",
      "expression": "In contrast,…",
      "formula": "前述情况。In contrast, + 对照的完整情况",
      "boundary": "对照双方应在同一维度上有可比性。in contrast 本身不表示先后顺序或因果。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-despite",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "承认一个条件，但说明结果仍不同于预期",
      "expression": "despite…",
      "formula": "Despite + 名词 / 动词-ing, + 完整结果",
      "boundary": "despite 后面不加 of，也不直接接普通完整句子。despite the fact that… 后才能接从句。",
      "functionGroup": "conditions",
      "functionSubgroup": "qualifications",
      "functionName": "让步与依赖",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-whether-or",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明尚未确定的两种选择",
      "expression": "whether…or…",
      "formula": "whether + 可能性A + or + 可能性B",
      "boundary": "whether 不能随意写成 weather。whether…or… 可表达间接选择，不需要按直接问句倒装。",
      "functionGroup": "conditions",
      "functionSubgroup": "exam-compare",
      "functionName": "对照与并列",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-one-way",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "提出解决问题的一种具体做法",
      "expression": "One way to…is to…",
      "formula": "One way to + 目标动作 + is to + 具体做法",
      "boundary": "目标与方法要有实际联系。两个 to 后都用动词原形，不把问题名称直接塞进动作位置。",
      "functionGroup": "thoughts",
      "functionSubgroup": "solution",
      "functionName": "提出具体办法",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-enable",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明某种条件让人能够做什么",
      "expression": "…enable someone to…",
      "formula": "条件 / 工具 + enable / enables + 人 + to + 动词原形",
      "boundary": "人放在 enable 与 to 之间。enable someone doing 不符合这个结构；提供机会不保证每个人都会使用。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-prevent",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明某种措施阻止什么事情发生",
      "expression": "…prevent…from…",
      "formula": "措施 + prevent / prevents + 人或事物 + from + 动词-ing",
      "boundary": "from 后接 -ing。prevent 强调阻止，不是仅仅增加不便；阻碍可能是暂时的，也不保证能消除全部风险。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-play-role",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "说明一个因素在某件事中的作用",
      "expression": "…play a role in…",
      "formula": "因素 + play / plays + a role in + 名词 / 动词-ing",
      "boundary": "role 前通常有 a，也可加 important、key 等修饰语。in 后接名词或 -ing，不接 to do。",
      "functionGroup": "conditions",
      "functionSubgroup": "cause-result",
      "functionName": "原因与结果",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-suggests",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "根据已给信息提出谨慎推断",
      "expression": "This suggests that…",
      "formula": "This suggests that + 推断的完整情况",
      "boundary": "必须有前文依据；它不是凭空给观点加可信度的装饰，也不表示已经证明因果。",
      "functionGroup": "thoughts",
      "functionSubgroup": "evaluation",
      "functionName": "谨慎推断与评价",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-to-extent",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "承认一种判断部分成立",
      "expression": "To some extent,…",
      "formula": "To some extent, + 部分成立的完整判断",
      "boundary": "后面仍要给出具体判断，必要时说明限制。不要把它与 completely 同时用于同一层面的断言。",
      "functionGroup": "thoughts",
      "functionSubgroup": "evaluation",
      "functionName": "谨慎推断与评价",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-admittedly",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "先承认一个事实或限制",
      "expression": "It is true that…",
      "formula": "It is true that + 承认的完整情况",
      "boundary": "后面用完整陈述句。承认事实不表示赞同所有结论；可以再解释限制或不同看法，但不必机械接 however。",
      "functionGroup": "thoughts",
      "functionSubgroup": "evaluation",
      "functionName": "谨慎推断与评价",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-outweigh",
      "domains": [
        "ielts",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "比较两方面的重要性，给出总体判断",
      "expression": "The benefits outweigh the costs.",
      "formula": "收益 / 风险 / 价值 + outweigh / outweighs + 相比较的另一方",
      "boundary": "outweigh 后直接接比较对象，不加 than。不是仅仅比较优缺点的数量，也不能代替对风险的具体分析。",
      "functionGroup": "thoughts",
      "functionSubgroup": "evaluation",
      "functionName": "谨慎推断与评价",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-in-other-words",
      "domains": [
        "ielts",
        "cet4",
        "cet6",
        "toefl"
      ],
      "skill": "writing",
      "task": "writing-foundation",
      "meaning": "用另一种表述澄清刚才的意思",
      "expression": "In other words,…",
      "formula": "前述意思。In other words, + 同义的解释",
      "boundary": "改写应保留核心意思，不能把“可能”改成“必然”，也不能借改写加入未经说明的结论。",
      "functionGroup": "responses",
      "functionSubgroup": "examples-rephrasing",
      "functionName": "举例与换说法",
      "goalGroups": [
        "exam-writing"
      ]
    },
    {
      "id": "e-limitation",
      "domains": [
        "ielts",
        "cet6",
        "toefl"
